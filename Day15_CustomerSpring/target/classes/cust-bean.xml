<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    
    <bean id = "cust"  class = "com.coforge.Bean.Customer" scope = "singleton">

			<property name="cid" value = "123456" ></property>
			<property name="cname" value = "Mayank"></property>
			<property name="mobile" value = "9936989208"></property>
			<property name="email" value = "rajat@example.com"></property>
			<property name="address" ref ="address" ></property>
    
    </bean>

    
    <bean id = "address" class = "com.coforge.Bean.Address">
    
        <constructor-arg name = "hno" value = "4567"></constructor-arg>
    	<constructor-arg name = "street" value = "Gacchibowli"></constructor-arg>
    	<constructor-arg name= "city" value = "Hyderabad"></constructor-arg>
    	<constructor-arg name= "state" value = "Telangana"></constructor-arg>
    	<constructor-arg name= "pincode" value = "500081"></constructor-arg>
    	
    	
    
    </bean>
    </beans>