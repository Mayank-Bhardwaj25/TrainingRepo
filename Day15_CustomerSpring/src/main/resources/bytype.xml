<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    
    <bean id = "cust2"  class = "com.coforge.Bean.Customer" scope = "singleton" autowire = "byType">

			<property name="cid" value = "837687629" ></property>
			<property name="cname" value = "Guarav"></property>
			<property name="mobile" value = "880899090"></property>
			<property name="email" value = "rajat@example.com"></property>
			
    </bean>

    
    <bean id = "address1" class = "com.coforge.Bean.Address">
    
        <constructor-arg name = "hno" value = "456789"></constructor-arg>
    	<constructor-arg name = "street" value = "Koti"></constructor-arg>
    	<constructor-arg name= "city" value = "Hyderabad"></constructor-arg>
    	<constructor-arg name= "state" value = "Telangana"></constructor-arg>
    	<constructor-arg name= "pincode" value = "500092"></constructor-arg>
    	
    	
    
    </bean>
    </beans>